      "tab_background_text_inactive":          [141, 136, 150],
      "tab_background_text_incognito":         [141, 136, 150],
      "tab_background_text_incognito_inactive":[  94,  87, 107],
      "tab_line":                              [117,  45, 240],
      "tab_text":                              [223, 221, 227],

      "toolbar":                               [ 28,  21,  40],
      "toolbar_button_icon":                   [182, 178, 189],
      "toolbar_text":                          [223, 221, 227]
