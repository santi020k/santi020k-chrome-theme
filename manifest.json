{
  "manifest_version": 3,
  "name": "Santi020k Theme",
  "version": "1.1.0",
  "description": "Browser chrome aligned with the Santi020k VS Code theme — deep violet surfaces, muted lavender text, and violet accents.",
  "homepage_url": "https://theme.santi020k.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "theme": {
    "images": {
      "theme_ntp_background": "images/theme_ntp_background.webp"
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat": "no-repeat"
    },
    "colors": {
      "bookmark_text":                         [223, 221, 227],
      "button_background":                     [ 50,  43,  64],
      "control_background":                    [ 35,  29,  48],

      "frame":                                 [ 11,   7,  18],
      "frame_inactive":                        [  7,   5,  11],
      "frame_incognito":                       [  8,   6,  14],
      "frame_incognito_inactive":              [  5,   4,   9],

      "background_tab":                        [ 11,   7,  18],

      "ntp_background":                        [ 17,  12,  29],
      "ntp_header":                            [ 28,  21,  40],
      "ntp_link":                              [148,  93, 244],
      "ntp_link_underline":                    [148,  93, 244],
      "ntp_section":                           [ 28,  21,  40],
      "ntp_section_link":                      [180, 141, 247],
      "ntp_section_text":                      [182, 178, 189],
      "ntp_text":                              [223, 221, 227],

      "omnibox_background":                    [ 17,  12,  29],
      "omnibox_text":                          [223, 221, 227],

      "tab_background_separator":              [ 35,  29,  48],
